{
  "name": "hermes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "files": ["dist"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup src/index.ts --format esm --clean --target node22 --out-dir dist",
    "test": "vitest run --passWithNoTests --no-file-parallelism",
    "test:db": "node -e \"try{process.loadEnvFile('../../.env')}catch{};if(!(process.env.TEST_DATABASE_URL||'').trim()){console.error('TEST_DATABASE_URL is unset - pnpm test:db needs a scratch database. See packages/store/README.md');process.exit(1)}\" && vitest run --no-file-parallelism"
  },
  "dependencies": {
    "@hermes/agent": "workspace:*",
    "@hermes/channels": "workspace:*",
    "@hermes/config": "workspace:*",
    "@hermes/core": "workspace:*",
    "@hermes/google-auth": "workspace:*",
    "@hermes/google-calendar": "workspace:*",
    "@hermes/google-gmail": "workspace:*",
    "@hermes/google-sheets": "workspace:*",
    "@hermes/llm": "workspace:*",
    "@hermes/store": "workspace:*",
    "@hermes/telemetry": "workspace:*",
    "google-auth-library": "^9.15.0",
    "zod": "^3.25.0"
  }
}
