# Telegram bot token from @BotFather (see README.md's Setup section).
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user ids allowed to talk to the bot.
# Empty means "reject everyone" (fail closed) — see README.md for the
# bootstrap flow to find your own id.
TELEGRAM_ALLOWLIST=

# LLM primary provider profile — all three required. Boot fails naming the
# missing key if any one is unset. Dev convention: point these at a free
# tier (e.g. Gemini's OpenAI-compatible endpoint) so local runs cost nothing.
LLM_PRIMARY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=gemini-3.6-flash

# LLM fallback provider profile — optional, but all three must be set
# together or all left empty (partial fallback config fails boot naming the
# missing key). Leave all three empty for a primary-only dev setup.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# Monthly spend ceiling in USD across both profiles, enforced before every
# provider call: once spend since the start of the current calendar month
# (UTC) reaches this, completions are refused until the month rolls over.
# The ceiling gates the NEXT call against already-recorded spend, so real
# spend is bounded to within one call's cost of this number, not to an exact
# hard stop - see packages/llm/README.md.
LLM_MONTHLY_BUDGET_USD=

# Postgres connection string for the DB integration tests (`pnpm test:db`).
# Point it at a SCRATCH database, not the one Hermes runs against — the tests
# apply migrations and truncate tables. With the compose Postgres up:
#   docker exec <postgres-container> psql -U hermes -d postgres -c "CREATE DATABASE hermes_test;"
# Unset, `pnpm test` skips these tests silently and `pnpm test:db` fails loudly.
TEST_DATABASE_URL=postgres://hermes:hermes@127.0.0.1:5432/hermes_test
